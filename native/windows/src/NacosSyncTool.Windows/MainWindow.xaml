<Window x:Class="NacosSyncTool.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:NacosSyncTool.Windows.Models"
        xmlns:converters="clr-namespace:NacosSyncTool.Windows.Converters"
        Title="Nacos Sync Tool"
        Height="680"
        Width="980"
        MinHeight="660"
        MinWidth="940"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
  <Window.Resources>
    <converters:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
    <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    <converters:SourceConnectingTextConverter x:Key="SourceConnectingTextConverter"/>
    <converters:TargetConnectingTextConverter x:Key="TargetConnectingTextConverter"/>
    <converters:SyncModeToBoolConverter x:Key="SyncModeConverter"/>
    <converters:SyncModeToVisibilityConverter x:Key="SyncModeToVisibilityConverter"/>
    <converters:KeySyncStrategyConverter x:Key="KeySyncStrategyConverter"/>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
  </Window.Resources>

  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="5"/>
      <RowDefinition Height="150"/>
    </Grid.RowDefinitions>

    <!-- 标题栏 -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
            CornerRadius="6" Padding="14,8" Margin="0,0,0,8">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="22" Height="22" CornerRadius="999"
                  Background="{DynamicResource AccentStrongBrush}"
                  Margin="0,0,8,0">
            <TextBlock Text="NS" Foreground="White" FontSize="9" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="Nacos Sync Tool" FontWeight="SemiBold" FontSize="14"
                     Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
          <TextBlock Text="{x:Static models:AppMetadata.VersionLabel}"
                     Foreground="{DynamicResource FaintBrush}" FontSize="11"
                     VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Text="主题" Foreground="{DynamicResource MutedBrush}"
                     VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11"/>
          <ComboBox x:Name="ThemeSelector" Width="96" SelectionChanged="OnThemeChanged">
            <ComboBoxItem Content="森林" Tag="Forest" IsSelected="True"/>
            <ComboBoxItem Content="深灰" Tag="Slate"/>
            <ComboBoxItem Content="暖色" Tag="Warm"/>
            <ComboBoxItem Content="海洋" Tag="Nexus"/>
          </ComboBox>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 连接区 -->
    <Grid Grid.Row="1" Margin="0,0,0,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- 源端 Nacos -->
      <Border x:Name="SourcePanel" Grid.Column="0"
              Style="{StaticResource ConnPanel}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- 面板标题 + 状态药丸 -->
          <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="源端 Nacos（只读）" Style="{StaticResource PanelTitle}"
                         VerticalAlignment="Center"/>
            </StackPanel>
            <!-- 未连接药丸 -->
            <Border Style="{StaticResource StatusPillPanel}"
                    Visibility="{Binding IsSourceConnected, Converter={StaticResource InverseBoolToVisibility}}">
              <StackPanel Orientation="Horizontal">
                <Ellipse Style="{StaticResource StatusDot}"/>
                <TextBlock Text="未连接" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <!-- 已连接药丸 -->
            <Border Style="{StaticResource StatusPillPanel}"
                    Visibility="{Binding IsSourceConnected, Converter={StaticResource BoolToVisibility}}">
              <StackPanel Orientation="Horizontal">
                <Ellipse Style="{StaticResource StatusDot}" Fill="{DynamicResource AccentBrush}"/>
                <TextBlock Text="已连接" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentStrongBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
          </Grid>

          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 地址 -->
            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
              <TextBlock Text="地址" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding SourceAddress, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <!-- 账号 -->
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
              <TextBlock Text="账号" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding SourceUsername, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <!-- 密码 + 测试按钮 -->
            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,8">
              <TextBlock Text="密码" Style="{StaticResource FieldLabel}"/>
              <PasswordBox x:Name="SourcePasswordBox" PasswordChanged="OnSourcePasswordChanged"/>
            </StackPanel>
            <Button Grid.Row="2" Grid.Column="2" VerticalAlignment="Bottom"
                    Command="{Binding TestSourceConnectionCommand}"
                    IsEnabled="{Binding IsSourceConnecting, Converter={StaticResource InverseBoolConverter}}"
                    Style="{StaticResource PrimaryButton}"
                    Content="{Binding IsSourceConnecting, Converter={StaticResource SourceConnectingTextConverter}}"/>

            <!-- Namespace -->
            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,4,0,0">
              <TextBlock Text="Namespace" Style="{StaticResource FieldLabel}"/>
              <ComboBox ItemsSource="{Binding SourceNamespaces}"
                        SelectedItem="{Binding SelectedSourceNamespace}"
                        DisplayMemberPath="DisplayText"
                        IsEnabled="{Binding IsSourceConnected}"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <!-- 目标端 Nacos -->
      <Border x:Name="TargetPanel" Grid.Column="2"
              Style="{StaticResource ConnPanel}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="目标端 Nacos" Style="{StaticResource PanelTitle}" VerticalAlignment="Center"/>
            <Border Style="{StaticResource StatusPillPanel}"
                    Visibility="{Binding IsTargetConnected, Converter={StaticResource InverseBoolToVisibility}}">
              <StackPanel Orientation="Horizontal">
                <Ellipse Style="{StaticResource StatusDot}"/>
                <TextBlock Text="未连接" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource StatusPillPanel}"
                    Visibility="{Binding IsTargetConnected, Converter={StaticResource BoolToVisibility}}">
              <StackPanel Orientation="Horizontal">
                <Ellipse Style="{StaticResource StatusDot}" Fill="{DynamicResource AccentBrush}"/>
                <TextBlock Text="已连接" FontSize="10" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentStrongBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
          </Grid>

          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
              <TextBlock Text="地址" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding TargetAddress, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
              <TextBlock Text="账号" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding TargetUsername, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,8">
              <TextBlock Text="密码" Style="{StaticResource FieldLabel}"/>
              <PasswordBox x:Name="TargetPasswordBox" PasswordChanged="OnTargetPasswordChanged"/>
            </StackPanel>
            <Button Grid.Row="2" Grid.Column="2" VerticalAlignment="Bottom"
                    Command="{Binding TestTargetConnectionCommand}"
                    IsEnabled="{Binding IsTargetConnecting, Converter={StaticResource InverseBoolConverter}}"
                    Style="{StaticResource PrimaryButton}"
                    Content="{Binding IsTargetConnecting, Converter={StaticResource TargetConnectingTextConverter}}"/>

            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,4,0,0">
              <TextBlock Text="Namespace" Style="{StaticResource FieldLabel}"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="6"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding TargetNamespaces}"
                          SelectedItem="{Binding SelectedTargetNamespace}"
                          DisplayMemberPath="DisplayText"
                          IsEnabled="{Binding IsTargetConnected}"/>
                <Button Grid.Column="2" Content="＋"
                        Command="{Binding CreateTargetNamespaceCommand}"
                        IsEnabled="{Binding IsTargetConnected}"
                        Style="{StaticResource IconButton}"/>
              </Grid>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- 中间数据区 -->
    <Border Grid.Row="2" Background="{DynamicResource SurfaceRaisedBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
            CornerRadius="6">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                Padding="14,10" Background="{DynamicResource SurfaceBrush}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 模式卡片 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="同步等级" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                         FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <RadioButton x:Name="ModeNs" GroupName="SyncMode" Margin="0,0,6,0" VerticalAlignment="Center"
                           IsChecked="{Binding SyncMode, Converter={StaticResource SyncModeConverter}, ConverterParameter=Namespace, Mode=TwoWay}">
                <RadioButton.Template>
                  <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Style="{StaticResource ModeOptionBorder}">
                      <StackPanel Orientation="Horizontal">
                        <ContentPresenter VerticalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="#9fc6b6"/>
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="#aeb8ad"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </RadioButton.Template>
                <TextBlock Text="Namespace" FontWeight="SemiBold" FontSize="12"/>
              </RadioButton>
              <RadioButton x:Name="ModeFile" GroupName="SyncMode" Margin="0,0,6,0" VerticalAlignment="Center"
                           IsChecked="{Binding SyncMode, Converter={StaticResource SyncModeConverter}, ConverterParameter=File, Mode=TwoWay}">
                <RadioButton.Template>
                  <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Style="{StaticResource ModeOptionBorder}">
                      <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="#9fc6b6"/>
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="#aeb8ad"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </RadioButton.Template>
                <TextBlock Text="文件" FontWeight="SemiBold" FontSize="12"/>
              </RadioButton>
              <RadioButton x:Name="ModeKey" GroupName="SyncMode" VerticalAlignment="Center"
                           IsChecked="{Binding SyncMode, Converter={StaticResource SyncModeConverter}, ConverterParameter=Key, Mode=TwoWay}">
                <RadioButton.Template>
                  <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Style="{StaticResource ModeOptionBorder}">
                      <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="#9fc6b6"/>
                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="BorderBrush" Value="#aeb8ad"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </RadioButton.Template>
                <TextBlock Text="Key" FontWeight="SemiBold" FontSize="12"/>
              </RadioButton>
            </StackPanel>

            <!-- Key 扫描输入 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding SyncMode, Converter={StaticResource SyncModeToVisibilityConverter}, ConverterParameter=Key}">
              <TextBox Width="180" Margin="0,0,6,0"
                       Text="{Binding KeyName, UpdateSourceTrigger=PropertyChanged}"
                       ToolTip="输入要扫描的 Key 名称（支持 a.b.c 路径）"/>
              <Button Content="扫描" Style="{StaticResource SecondaryButton}"
                      Command="{Binding ScanKeyCommand}"/>
            </StackPanel>

            <!-- 加载配置按钮（仅文件模式） -->
            <Button Grid.Column="4" Content="加载配置" Style="{StaticResource SecondaryButton}"
                    Command="{Binding LoadConfigListCommand}"
                    Visibility="{Binding SyncMode, Converter={StaticResource SyncModeToVisibilityConverter}, ConverterParameter=File}"/>
          </Grid>
        </Border>

        <!-- 数据表格区 -->
        <Grid Grid.Row="1">
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{DynamicResource MutedBrush}" TextAlignment="Center"
                     Visibility="{Binding SyncMode, Converter={StaticResource SyncModeToVisibilityConverter}, ConverterParameter=Namespace}">
            <Run Text="Namespace 级别同步" FontSize="13" FontWeight="SemiBold"/><LineBreak/>
            <Run Text="将源 Namespace 下所有配置同步到目标，支持双重确认" FontSize="11"/>
          </TextBlock>

          <DataGrid ItemsSource="{Binding ConfigList}"
                    Visibility="{Binding SyncMode, Converter={StaticResource SyncModeToVisibilityConverter}, ConverterParameter=File}">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="选择" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="46"/>
              <DataGridTextColumn Header="DataId" Binding="{Binding DataId}" Width="*"/>
              <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="140"/>
              <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="76"/>
            </DataGrid.Columns>
          </DataGrid>

          <DataGrid ItemsSource="{Binding KeyScanResults}"
                    Visibility="{Binding SyncMode, Converter={StaticResource SyncModeToVisibilityConverter}, ConverterParameter=Key}">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="选择" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="46"/>
              <DataGridTextColumn Header="DataId" Binding="{Binding DataId}" Width="*"/>
              <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="120"/>
              <DataGridTextColumn Header="Key 路径" Binding="{Binding KeyPath}" Width="150"/>
              <DataGridTextColumn Header="原值" Binding="{Binding Value}" Width="200"/>
              <DataGridTemplateColumn Header="同步方式" Width="130">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <ComboBox SelectedIndex="{Binding SyncStrategy, Converter={StaticResource KeySyncStrategyConverter}, UpdateSourceTrigger=PropertyChanged}" Margin="2">
                      <ComboBoxItem Content="仅同步 Key"/>
                      <ComboBoxItem Content="同步整个文件"/>
                    </ComboBox>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>

          <!-- 开始同步（右下角悬浮，所有模式可见） -->
          <Button Content="开始同步" Style="{StaticResource PrimaryButton}"
                  Padding="22,9" FontSize="13"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="0,0,14,12"
                  Command="{Binding SyncCommand}"
                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
        </Grid>
      </Grid>
    </Border>

    <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch"
                  Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"/>

    <!-- 日志面板（深色终端风） -->
    <Border Grid.Row="4" Style="{StaticResource LogWindow}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="12,8,12,6">
          <TextBlock Text="日志" FontWeight="SemiBold" Foreground="#e6ece5" VerticalAlignment="Center"/>
          <Button Content="清空日志" Command="{Binding ClearLogsCommand}"
                  Style="{StaticResource SecondaryButton}" Padding="8,4"
                  HorizontalAlignment="Right"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto" Margin="0,0,0,8">
          <ItemsControl ItemsSource="{Binding Logs}" Margin="12,0,12,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding FormattedMessage}"
                           Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                           FontFamily="Consolas, Courier New" FontSize="12" Margin="0,2"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</Window>




