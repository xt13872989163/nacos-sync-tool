<Window x:Class="NacosSyncTool.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:NacosSyncTool.Windows.Models"
        xmlns:converters="clr-namespace:NacosSyncTool.Windows.Converters"
        Title="Nacos Sync Tool"
        Height="720"
        Width="1080"
        MinHeight="720"
        MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}">
  <Window.Resources>
    <converters:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
    <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    <converters:SourceConnectingTextConverter x:Key="SourceConnectingTextConverter"/>
    <converters:TargetConnectingTextConverter x:Key="TargetConnectingTextConverter"/>
    <converters:SyncModeToBoolConverter x:Key="SyncModeConverter"/>
    <converters:SyncModeToVisibilityConverter x:Key="SyncModeToVisibilityConverter"/>
    <converters:KeySyncStrategyConverter x:Key="KeySyncStrategyConverter"/>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><!-- 标题栏 -->
      <RowDefinition Height="Auto"/><!-- 连接区 -->
      <RowDefinition Height="*"/>   <!-- 中间数据区 -->
      <RowDefinition Height="Auto"/><!-- GridSplitter -->
      <RowDefinition Height="150"/> <!-- 日志面板 -->
    </Grid.RowDefinitions>

    <!-- 标题栏 -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
            Padding="16,12">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="NS" FontWeight="Bold" FontSize="16"
                     Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
          <TextBlock Text="Nacos Sync Tool" FontWeight="SemiBold" FontSize="16"
                     Foreground="{DynamicResource TextBrush}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Text="主题" Foreground="{DynamicResource MutedBrush}"
                     VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ComboBox x:Name="ThemeSelector" Width="100" SelectionChanged="OnThemeChanged">
            <ComboBoxItem Content="森林" Tag="Forest" IsSelected="True"/>
            <ComboBoxItem Content="深灰" Tag="Slate"/>
            <ComboBoxItem Content="暖色" Tag="Warm"/>
            <ComboBoxItem Content="海洋" Tag="Nexus"/>
          </ComboBox>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 连接区 -->
    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
            Padding="16" Margin="0,8,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 源端 Nacos -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                CornerRadius="4" Padding="16">
          <StackPanel>
            <TextBlock Text="源端 Nacos（只读）" FontWeight="SemiBold" FontSize="14"
                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>

            <!-- 地址 -->
            <TextBlock Text="地址" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding SourceAddress, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12"/>

            <!-- 账号 -->
            <TextBlock Text="账号" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding SourceUsername, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12"/>

            <!-- 密码 -->
            <TextBlock Text="密码" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="SourcePasswordBox" PasswordChanged="OnSourcePasswordChanged"
                         Margin="0,0,0,12"/>

            <!-- 连接按钮 -->
            <Button Command="{Binding TestSourceConnectionCommand}"
                    IsEnabled="{Binding IsSourceConnecting, Converter={StaticResource InverseBoolConverter}}"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,0,0,12">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding IsSourceConnecting, Converter={StaticResource SourceConnectingTextConverter}}"
                           VerticalAlignment="Center"/>
              </StackPanel>
            </Button>

            <!-- Namespace 选择 -->
            <TextBlock Text="Namespace" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding SourceNamespaces}"
                      SelectedItem="{Binding SelectedSourceNamespace}"
                      DisplayMemberPath="DisplayText"
                      IsEnabled="{Binding IsSourceConnected}"/>
          </StackPanel>
        </Border>

        <!-- 目标端 Nacos -->
        <Border Grid.Column="2" Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                CornerRadius="4" Padding="16">
          <StackPanel>
            <TextBlock Text="目标端 Nacos" FontWeight="SemiBold" FontSize="14"
                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>

            <!-- 地址 -->
            <TextBlock Text="地址" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding TargetAddress, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12"/>

            <!-- 账号 -->
            <TextBlock Text="账号" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding TargetUsername, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12"/>

            <!-- 密码 -->
            <TextBlock Text="密码" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="TargetPasswordBox" PasswordChanged="OnTargetPasswordChanged"
                         Margin="0,0,0,12"/>

            <!-- 连接按钮 -->
            <Button Command="{Binding TestTargetConnectionCommand}"
                    IsEnabled="{Binding IsTargetConnecting, Converter={StaticResource InverseBoolConverter}}"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,0,0,12">
              <TextBlock Text="{Binding IsTargetConnecting, Converter={StaticResource TargetConnectingTextConverter}}"
                         VerticalAlignment="Center"/>
            </Button>

            <!-- Namespace 选择 + 新建按钮 -->
            <TextBlock Text="Namespace" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <ComboBox Grid.Column="0"
                        ItemsSource="{Binding TargetNamespaces}"
                        SelectedItem="{Binding SelectedTargetNamespace}"
                        DisplayMemberPath="DisplayText"
                        IsEnabled="{Binding IsTargetConnected}"/>

              <Button Grid.Column="2"
                      Content="新建"
                      Command="{Binding CreateTargetNamespaceCommand}"
                      IsEnabled="{Binding IsTargetConnected}"
                      Style="{StaticResource SecondaryButton}"
                      Padding="12,6"/>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- 中间数据区 -->
    <Border Grid.Row="2" Background="{DynamicResource SurfaceRaisedBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
            Margin="16,8" Padding="16">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><!-- 工具栏 -->
          <RowDefinition Height="*"/>   <!-- 数据表格 -->
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- 同步模式选择 -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="同步等级：" Foreground="{DynamicResource MutedBrush}"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <StackPanel Orientation="Horizontal">
              <RadioButton Content="Namespace" Margin="0,0,12,0" VerticalAlignment="Center"
                           IsChecked="{Binding SyncMode, Converter={StaticResource SyncModeConverter}, ConverterParameter=Namespace, Mode=TwoWay}"/>
              <RadioButton Content="文件" Margin="0,0,12,0" VerticalAlignment="Center"
                           IsChecked="{Binding SyncMode, Converter={StaticResource SyncModeConverter}, ConverterParameter=File, Mode=TwoWay}"/>
              <RadioButton Content="Key" VerticalAlignment="Center"
                           IsChecked="{Binding SyncMode, Converter={StaticResource SyncModeConverter}, ConverterParameter=Key, Mode=TwoWay}"/>
            </StackPanel>
          </StackPanel>

          <!-- Key 扫描输入（仅 Key 模式显示） -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBox Width="200" Margin="0,0,8,0"
                     Text="{Binding KeyName, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="输入要扫描的 Key 名称（支持 a.b.c 路径）"/>
            <Button Content="扫描" Style="{StaticResource SecondaryButton}" Padding="12,6"
                    Command="{Binding ScanKeyCommand}"/>
          </StackPanel>

          <!-- 加载配置按钮（文件模式显示） -->
          <Button Grid.Column="4" Content="加载配置" Style="{StaticResource SecondaryButton}"
                  Padding="12,6" Command="{Binding LoadConfigListCommand}"/>
        </Grid>

        <!-- 数据表格区 -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
          <Grid>
            <!-- Namespace 模式：显示提示 -->
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}"
                       Visibility="{Binding SyncMode, Converter={StaticResource SyncModeToVisibilityConverter}, ConverterParameter=Namespace}">
                <Run Text="Namespace 级别同步"/>
                <LineBreak/>
                <Run Text="将源 Namespace 下所有配置同步到目标，支持双重确认"/>
            </TextBlock>

            <!-- 文件模式：配置列表 -->
            <DataGrid ItemsSource="{Binding ConfigList}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Extended"
                      HeadersVisibility="Column"
                      Visibility="{Binding SyncMode, Converter={StaticResource SyncModeToVisibilityConverter}, ConverterParameter=File}">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="选择" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                <DataGridTextColumn Header="DataId" Binding="{Binding DataId}" Width="*"/>
                <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="150"/>
                <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="80"/>
              </DataGrid.Columns>
            </DataGrid>

            <!-- Key 模式：扫描结果列表 -->
            <DataGrid ItemsSource="{Binding KeyScanResults}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Extended"
                      HeadersVisibility="Column"
                      Visibility="{Binding SyncMode, Converter={StaticResource SyncModeToVisibilityConverter}, ConverterParameter=Key}">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="选择" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                <DataGridTextColumn Header="DataId" Binding="{Binding DataId}" Width="*"/>
                <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="120"/>
                <DataGridTextColumn Header="Key 路径" Binding="{Binding KeyPath}" Width="150"/>
                <DataGridTextColumn Header="原值" Binding="{Binding Value}" Width="200"/>
                <DataGridTemplateColumn Header="同步方式" Width="120">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <ComboBox SelectedIndex="{Binding SyncStrategy, Converter={StaticResource KeySyncStrategyConverter}, UpdateSourceTrigger=PropertyChanged}"
                                Margin="2">
                        <ComboBoxItem Content="仅同步 Key"/>
                        <ComboBoxItem Content="同步整个文件"/>
                      </ComboBox>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>

        <!-- 同步按钮（底部悬浮） -->
        <Button Grid.Row="1" Content="开始同步" Style="{StaticResource PrimaryButton}"
                Padding="24,10" FontSize="14"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,16,16"
                Command="{Binding SyncCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
      </Grid>
    </Border>

    <!-- GridSplitter -->
    <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch"
                  Background="{DynamicResource LineBrush}"
                  ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"/>

    <!-- 日志面板 -->
    <Border Grid.Row="4" Background="{DynamicResource SurfaceRaisedBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,1,1"
            Padding="16">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
          <TextBlock Text="日志" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextBrush}"
                     VerticalAlignment="Center"/>

          <Button Content="清空日志"
                  Command="{Binding ClearLogsCommand}"
                  Style="{StaticResource SecondaryButton}"
                  Padding="8,4"
                  HorizontalAlignment="Right"/>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Logs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding FormattedMessage}"
                           Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                           FontFamily="Consolas, Courier New"
                           FontSize="12"
                           Margin="0,2"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</Window>
