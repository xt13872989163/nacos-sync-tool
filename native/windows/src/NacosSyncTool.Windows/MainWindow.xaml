<Window x:Class="NacosSyncTool.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:NacosSyncTool.Windows.Models"
        xmlns:converters="clr-namespace:NacosSyncTool.Windows.Converters"
        xmlns:rabbitViews="clr-namespace:NacosSyncTool.Windows.Modules.RabbitMq.Views"
        Title="Nacos / RabbitMQ Sync Tool"
        Height="720"
        Width="1060"
        MinHeight="680"
        MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
  <Window.Resources>
    <converters:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
    <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    <converters:SourceConnectingTextConverter x:Key="SourceConnectingTextConverter"/>
    <converters:TargetConnectingTextConverter x:Key="TargetConnectingTextConverter"/>
    <converters:SyncModeToBoolConverter x:Key="SyncModeConverter"/>
    <converters:SyncModeToVisibilityConverter x:Key="SyncModeToVisibilityConverter"/>
    <converters:KeySyncStrategyConverter x:Key="KeySyncStrategyConverter"/>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
  </Window.Resources>

  <Grid>
  <Grid x:Name="NacosModuleRoot" Margin="14"
        DataContext="{Binding Nacos}"
        Visibility="{Binding DataContext.IsNacosSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="6"/>
      <RowDefinition Height="122"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource TopBar}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="26" Height="26" CornerRadius="5"
                  Background="{DynamicResource AccentStrongBrush}"
                  Margin="0,0,10,0">
            <TextBlock Text="NS" Foreground="White" FontSize="10" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Nacos Sync Tool" FontWeight="SemiBold" FontSize="15"
                       Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="Native Windows" Foreground="{DynamicResource FaintBrush}"
                       FontSize="11" Margin="0,1,0,0"/>
          </StackPanel>
          <TextBlock Text="{x:Static models:AppMetadata.VersionLabel}"
                     Foreground="{DynamicResource FaintBrush}" FontSize="11"
                     VerticalAlignment="Top" Margin="12,3,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button Content="Nacos" Style="{StaticResource PrimaryButton}" Padding="16,6"
                  Command="{Binding DataContext.SelectNacosCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
          <Button Content="RabbitMQ" Style="{StaticResource SecondaryButton}" Padding="16,6" Margin="8,0,0,0"
                  Command="{Binding DataContext.SelectRabbitMqCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Text="主题" Style="{StaticResource SubtleLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ComboBox x:Name="ThemeSelector" Width="100" SelectionChanged="OnThemeChanged">
            <ComboBoxItem Content="森林" Tag="Forest" IsSelected="True"/>
            <ComboBoxItem Content="深灰" Tag="Slate"/>
            <ComboBoxItem Content="暖色" Tag="Warm"/>
            <ComboBoxItem Content="海洋" Tag="Nexus"/>
          </ComboBox>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="0,12,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="72"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border x:Name="SourcePanel" Grid.Column="0" Style="{StaticResource FlowPanel}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="源端 Nacos" Style="{StaticResource PanelTitle}"/>
              <TextBlock Text="只读取源配置，不写入" Foreground="{DynamicResource FaintBrush}" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
              <Border Style="{StaticResource StatusPillPanel}"
                      Visibility="{Binding IsSourceConnected, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Style="{StaticResource StatusDot}"/>
                  <TextBlock Text="未连接" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource StatusPillPanel}"
                      Visibility="{Binding IsSourceConnected, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Style="{StaticResource StatusDot}" Fill="{DynamicResource AccentBrush}"/>
                  <TextBlock Text="已连接" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentStrongBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.45*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="地址" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding SourceAddress, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="账号" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding SourceUsername, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBlock Text="密码" Style="{StaticResource FieldLabel}"/>
              <PasswordBox x:Name="SourcePasswordBox" PasswordChanged="OnSourcePasswordChanged"/>
            </StackPanel>
            <Button Grid.Column="6" VerticalAlignment="Bottom"
                    Command="{Binding TestSourceConnectionCommand}"
                    IsEnabled="{Binding IsSourceConnecting, Converter={StaticResource InverseBoolConverter}}"
                    Style="{StaticResource PrimaryButton}"
                    Content="{Binding IsSourceConnecting, Converter={StaticResource SourceConnectingTextConverter}}"/>
          </Grid>

          <StackPanel Grid.Row="2">
            <TextBlock Text="Namespace" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding SourceNamespaces}"
                      SelectedItem="{Binding SelectedSourceNamespace}"
                      DisplayMemberPath="DisplayText"
                      IsEnabled="{Binding IsSourceConnected}"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Style="{StaticResource SyncArrowBadge}">
          <TextBlock Text="→" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AccentStrongBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
      </Grid>

      <Border x:Name="TargetPanel" Grid.Column="2" Style="{StaticResource FlowPanel}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="目标端 Nacos" Style="{StaticResource PanelTitle}"/>
              <TextBlock Text="同步写入目标 Namespace" Foreground="{DynamicResource FaintBrush}" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
              <Border Style="{StaticResource StatusPillPanel}"
                      Visibility="{Binding IsTargetConnected, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Style="{StaticResource StatusDot}"/>
                  <TextBlock Text="未连接" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource StatusPillPanel}"
                      Visibility="{Binding IsTargetConnected, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                  <Ellipse Style="{StaticResource StatusDot}" Fill="{DynamicResource AccentBrush}"/>
                  <TextBlock Text="已连接" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentStrongBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.45*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="地址" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding TargetAddress, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="账号" Style="{StaticResource FieldLabel}"/>
              <TextBox Text="{Binding TargetUsername, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBlock Text="密码" Style="{StaticResource FieldLabel}"/>
              <PasswordBox x:Name="TargetPasswordBox" PasswordChanged="OnTargetPasswordChanged"/>
            </StackPanel>
            <Button Grid.Column="6" VerticalAlignment="Bottom"
                    Command="{Binding TestTargetConnectionCommand}"
                    IsEnabled="{Binding IsTargetConnecting, Converter={StaticResource InverseBoolConverter}}"
                    Style="{StaticResource PrimaryButton}"
                    Content="{Binding IsTargetConnecting, Converter={StaticResource TargetConnectingTextConverter}}"/>
          </Grid>

          <StackPanel Grid.Row="2">
            <TextBlock Text="Namespace" Style="{StaticResource FieldLabel}"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ComboBox Grid.Column="0"
                        ItemsSource="{Binding TargetNamespaces}"
                        SelectedItem="{Binding SelectedTargetNamespace}"
                        DisplayMemberPath="DisplayText"
                        IsEnabled="{Binding IsTargetConnected}"/>
              <Button Grid.Column="2" Content="+"
                      Command="{Binding CreateTargetNamespaceCommand}"
                      IsEnabled="{Binding IsTargetConnected}"
                      Style="{StaticResource IconButton}"/>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Style="{StaticResource WorkbenchShell}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="150"/>
          <ColumnDefinition Width="1"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" Padding="14,14,12,14">
          <StackPanel>
            <TextBlock Text="同步等级" Style="{StaticResource SubtleLabel}" Margin="0,0,0,10"/>

            <RadioButton GroupName="SyncMode" Margin="0,0,0,8"
                         IsChecked="{Binding SyncMode, Converter={StaticResource SyncModeConverter}, ConverterParameter=Namespace, Mode=TwoWay}">
              <RadioButton.Template>
                <ControlTemplate TargetType="RadioButton">
                  <Border x:Name="Bd" Style="{StaticResource SideModeOptionBorder}">
                    <StackPanel>
                      <TextBlock Text="Namespace" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
                      <TextBlock Text="整空间同步" FontSize="10" Foreground="{DynamicResource FaintBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                      <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource LineStrongBrush}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </RadioButton.Template>
            </RadioButton>

            <RadioButton GroupName="SyncMode" Margin="0,0,0,8"
                         IsChecked="{Binding SyncMode, Converter={StaticResource SyncModeConverter}, ConverterParameter=File, Mode=TwoWay}">
              <RadioButton.Template>
                <ControlTemplate TargetType="RadioButton">
                  <Border x:Name="Bd" Style="{StaticResource SideModeOptionBorder}">
                    <StackPanel>
                      <TextBlock Text="文件" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
                      <TextBlock Text="选择配置文件" FontSize="10" Foreground="{DynamicResource FaintBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                      <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource LineStrongBrush}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </RadioButton.Template>
            </RadioButton>

            <RadioButton GroupName="SyncMode"
                         IsChecked="{Binding SyncMode, Converter={StaticResource SyncModeConverter}, ConverterParameter=Key, Mode=TwoWay}">
              <RadioButton.Template>
                <ControlTemplate TargetType="RadioButton">
                  <Border x:Name="Bd" Style="{StaticResource SideModeOptionBorder}">
                    <StackPanel>
                      <TextBlock Text="Key" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
                      <TextBlock Text="扫描单个键" FontSize="10" Foreground="{DynamicResource FaintBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                      <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource LineStrongBrush}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </RadioButton.Template>
            </RadioButton>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource LineBrush}"/>

        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                  Padding="16,12" Background="{DynamicResource SurfaceRaisedBrush}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Visibility="{Binding SyncMode, Converter={StaticResource SyncModeToVisibilityConverter}, ConverterParameter=Namespace}">
                  <TextBlock Text="Namespace 同步" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextBrush}"/>
                  <TextBlock Text="将源 Namespace 下的全部配置同步到目标" FontSize="11" Foreground="{DynamicResource FaintBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding SyncMode, Converter={StaticResource SyncModeToVisibilityConverter}, ConverterParameter=File}">
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="文件同步" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="先加载配置，再勾选要同步的文件" FontSize="11" Foreground="{DynamicResource FaintBrush}" Margin="0,2,0,0"/>
                  </StackPanel>
                  <Button Content="加载配置" Style="{StaticResource SecondaryButton}"
                          Command="{Binding LoadConfigListCommand}"
                          IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding SyncMode, Converter={StaticResource SyncModeToVisibilityConverter}, ConverterParameter=Key}">
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Key 同步" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="扫描配置里的指定 Key，并选择同步策略" FontSize="11" Foreground="{DynamicResource FaintBrush}" Margin="0,2,0,0"/>
                  </StackPanel>
                  <TextBox Width="210" Margin="0,0,8,0"
                           Text="{Binding KeyName, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="输入要扫描的 Key 名称（支持 a.b.c 路径），回车扫描"
                           KeyDown="OnScanKeyEnter"/>
                  <Button Content="扫描" Style="{StaticResource SecondaryButton}"
                          Command="{Binding ScanKeyCommand}"
                          IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                </StackPanel>
              </StackPanel>

              <Button Grid.Column="1" Content="开始同步" Style="{StaticResource PrimaryButton}"
                      Padding="24,8" FontSize="13"
                      Command="{Binding SyncCommand}"
                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
            </Grid>
          </Border>

          <Grid Grid.Row="1" Background="{DynamicResource SurfaceRaisedBrush}">
            <Grid Visibility="{Binding SyncMode, Converter={StaticResource SyncModeToVisibilityConverter}, ConverterParameter=Namespace}">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28">
                <TextBlock Text="Namespace 级别同步"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource MutedBrush}"
                           TextAlignment="Center"/>
                <TextBlock Text="连接源端和目标端后，点击右上角开始同步"
                           FontSize="12"
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,6,0,0"
                           TextAlignment="Center"/>
              </StackPanel>
            </Grid>

            <Grid Visibility="{Binding SyncMode, Converter={StaticResource SyncModeToVisibilityConverter}, ConverterParameter=File}">
              <StackPanel Orientation="Horizontal" Margin="10,6" VerticalAlignment="Top">
                <TextBlock Text="{Binding FileListSummary}" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,12,0"
                           Visibility="{Binding HasFileResults, Converter={StaticResource BoolToVisibility}}"/>
                <Button Content="全选" Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="0,0,6,0"
                        Command="{Binding SelectAllFilesCommand}"
                        Visibility="{Binding HasFileResults, Converter={StaticResource BoolToVisibility}}"/>
                <Button Content="反选" Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="0,0,6,0"
                        Command="{Binding InvertFileSelectionCommand}"
                        Visibility="{Binding HasFileResults, Converter={StaticResource BoolToVisibility}}"/>
                <Button Content="清空选择" Style="{StaticResource SecondaryButton}" Padding="8,3"
                        Command="{Binding ClearFileSelectionCommand}"
                        Visibility="{Binding HasFileResults, Converter={StaticResource BoolToVisibility}}"/>
              </StackPanel>

              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                          Visibility="{Binding HasFileResults, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="尚未加载配置"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextAlignment="Center"/>
                <TextBlock Text="点击上方“加载配置”按钮"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="12"
                           Margin="0,4,0,0"
                           TextAlignment="Center"/>
              </StackPanel>

              <DataGrid ItemsSource="{Binding ConfigList}"
                        PreviewMouseLeftButtonDown="OnSelectableDataGridPreviewMouseLeftButtonDown"
                        Margin="0,34,0,0"
                        Visibility="{Binding HasFileResults, Converter={StaticResource BoolToVisibility}}">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="选择" Width="54" IsReadOnly="False">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="DataId" Binding="{Binding DataId}" Width="*" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="150" IsReadOnly="True"/>
                  <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="80" IsReadOnly="True"/>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>

            <Grid Visibility="{Binding SyncMode, Converter={StaticResource SyncModeToVisibilityConverter}, ConverterParameter=Key}">
              <StackPanel Orientation="Horizontal" Margin="10,6" VerticalAlignment="Top">
                <TextBlock Text="{Binding KeyListSummary}" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,12,0"
                           Visibility="{Binding HasKeyResults, Converter={StaticResource BoolToVisibility}}"/>
                <Button Content="全选" Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="0,0,6,0"
                        Command="{Binding SelectAllKeysCommand}"
                        Visibility="{Binding HasKeyResults, Converter={StaticResource BoolToVisibility}}"/>
                <Button Content="反选" Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="0,0,6,0"
                        Command="{Binding InvertKeySelectionCommand}"
                        Visibility="{Binding HasKeyResults, Converter={StaticResource BoolToVisibility}}"/>
                <Button Content="清空选择" Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="0,0,6,0"
                        Command="{Binding ClearKeySelectionCommand}"
                        Visibility="{Binding HasKeyResults, Converter={StaticResource BoolToVisibility}}"/>
                <Border Width="1" Margin="6,4" Background="{DynamicResource LineBrush}"/>
                <Button Content="全部仅同步 Key" Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="0,0,6,0"
                        Command="{Binding SetAllKeyStrategyKeyOnlyCommand}"
                        Visibility="{Binding HasKeyResults, Converter={StaticResource BoolToVisibility}}"/>
                <Button Content="全部同步整个文件" Style="{StaticResource SecondaryButton}" Padding="8,3"
                        Command="{Binding SetAllKeyStrategyFullFileCommand}"
                        Visibility="{Binding HasKeyResults, Converter={StaticResource BoolToVisibility}}"/>
              </StackPanel>

              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                          Visibility="{Binding HasKeyResults, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="尚未扫描"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextAlignment="Center"/>
                <TextBlock Text="输入 Key 名称后点击“扫描”按钮"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="12"
                           Margin="0,4,0,0"
                           TextAlignment="Center"/>
              </StackPanel>

              <DataGrid ItemsSource="{Binding KeyScanResults}"
                        PreviewMouseLeftButtonDown="OnSelectableDataGridPreviewMouseLeftButtonDown"
                        Margin="0,34,0,0"
                        Visibility="{Binding HasKeyResults, Converter={StaticResource BoolToVisibility}}">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="选择" Width="54" IsReadOnly="False">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="DataId" Binding="{Binding DataId}" Width="*" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="120" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Key 路径" Binding="{Binding KeyPath}" Width="150" IsReadOnly="True"/>
                  <DataGridTemplateColumn Header="原值" Width="220" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource ValuePreviewButton}"
                                Tag="{Binding DisplayValue}"
                                Click="OnCopyValueClick"
                                ToolTipService.InitialShowDelay="120"
                                ToolTipService.ShowDuration="60000">
                          <Button.ToolTip>
                            <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                     Placement="Mouse"
                                     StaysOpen="False">
                              <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                      BorderBrush="{DynamicResource LineStrongBrush}"
                                      BorderThickness="1"
                                      CornerRadius="6"
                                      Padding="10"
                                      MaxWidth="540">
                                <Grid>
                                  <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                  </Grid.RowDefinitions>
                                  <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="原值" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    <Button Content="复制"
                                            Tag="{Binding DisplayValue}"
                                            Click="OnCopyValueClick"
                                            Style="{StaticResource PrimaryButton}"
                                            Padding="10,3"
                                            MinHeight="24"
                                            HorizontalAlignment="Right"/>
                                  </Grid>
                                  <TextBox Grid.Row="1"
                                           Text="{Binding DisplayValue}"
                                           IsReadOnly="True"
                                           TextWrapping="Wrap"
                                           AcceptsReturn="True"
                                           VerticalScrollBarVisibility="Auto"
                                           HorizontalScrollBarVisibility="Auto"
                                           MaxHeight="240"
                                           MinWidth="320"
                                           MaxWidth="520"
                                           FontFamily="Consolas, Microsoft YaHei UI"
                                           FontSize="12"
                                           Padding="8"/>
                                </Grid>
                              </Border>
                            </ToolTip>
                          </Button.ToolTip>
                          <TextBlock Text="{Binding DisplayValue}"
                                     TextTrimming="CharacterEllipsis"
                                     VerticalAlignment="Center"/>
                        </Button>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="同步方式" Width="138" IsReadOnly="False">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <ComboBox SelectedIndex="{Binding SyncStrategy, Converter={StaticResource KeySyncStrategyConverter}, UpdateSourceTrigger=PropertyChanged}" Margin="2">
                          <ComboBoxItem Content="仅同步 Key"/>
                          <ComboBoxItem Content="同步整个文件"/>
                        </ComboBox>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Border>

    <GridSplitter Grid.Row="3" Height="6" HorizontalAlignment="Stretch"
                  Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"/>

    <Border Grid.Row="4" Style="{StaticResource LogWindow}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="12,8,12,5">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="日志" FontWeight="SemiBold" Foreground="#e6ece5"/>
            <TextBlock Text="最近运行信息" Foreground="#849188" FontSize="11" Margin="8,1,0,0"/>
          </StackPanel>
          <Button Content="清空日志" Command="{Binding ClearLogsCommand}"
                  Style="{StaticResource SecondaryButton}" Padding="8,4"
                  HorizontalAlignment="Right"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto" Margin="0,0,0,8">
          <ItemsControl ItemsSource="{Binding Logs}" Margin="12,0,12,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding FormattedMessage}"
                           Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                           FontFamily="Consolas, Courier New" FontSize="12" Margin="0,2"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <Border Grid.RowSpan="5"
            Style="{StaticResource ToastBorder}"
            Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVisibility}}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,12,136"
            Panel.ZIndex="20"
            IsHitTestVisible="False">
      <TextBlock Text="{Binding ToastMessage}"
                 Foreground="{DynamicResource TextBrush}"
                 FontWeight="SemiBold"
                 FontSize="12"/>
    </Border>
  </Grid>
  <rabbitViews:RabbitMqModuleView DataContext="{Binding RabbitMq}"
                                  BackToNacosRequested="OnBackToNacosRequested"
                                  Visibility="{Binding DataContext.IsRabbitMqSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"/>
  </Grid>
</Window>
