<Window x:Class="NacosSyncTool.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:NacosSyncTool.Windows.Models"
        xmlns:converters="clr-namespace:NacosSyncTool.Windows.Converters"
        Title="Nacos Sync Tool"
        Height="720"
        Width="1080"
        MinHeight="720"
        MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}">
  <Window.Resources>
    <converters:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
    <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    <converters:SourceConnectingTextConverter x:Key="SourceConnectingTextConverter"/>
    <converters:TargetConnectingTextConverter x:Key="TargetConnectingTextConverter"/>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><!-- 标题栏 -->
      <RowDefinition Height="Auto"/><!-- 连接区 -->
      <RowDefinition Height="*"/>   <!-- 中间数据区 -->
      <RowDefinition Height="Auto"/><!-- GridSplitter -->
      <RowDefinition Height="150"/> <!-- 日志面板 -->
    </Grid.RowDefinitions>

    <!-- 标题栏 -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
            Padding="16,12">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="NS" FontWeight="Bold" FontSize="16"
                     Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
          <TextBlock Text="Nacos Sync Tool" FontWeight="SemiBold" FontSize="16"
                     Foreground="{DynamicResource TextBrush}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Text="主题" Foreground="{DynamicResource MutedBrush}"
                     VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ComboBox x:Name="ThemeSelector" Width="100" SelectionChanged="OnThemeChanged">
            <ComboBoxItem Content="森林" Tag="Forest" IsSelected="True"/>
            <ComboBoxItem Content="深灰" Tag="Slate"/>
            <ComboBoxItem Content="暖色" Tag="Warm"/>
            <ComboBoxItem Content="海洋" Tag="Nexus"/>
          </ComboBox>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 连接区 -->
    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
            Padding="16" Margin="0,8,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 源端 Nacos -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                CornerRadius="4" Padding="16">
          <StackPanel>
            <TextBlock Text="源端 Nacos（只读）" FontWeight="SemiBold" FontSize="14"
                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>

            <!-- 地址 -->
            <TextBlock Text="地址" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding SourceAddress, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12"/>

            <!-- 账号 -->
            <TextBlock Text="账号" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding SourceUsername, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12"/>

            <!-- 密码 -->
            <TextBlock Text="密码" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="SourcePasswordBox" PasswordChanged="OnSourcePasswordChanged"
                         Margin="0,0,0,12"/>

            <!-- 连接按钮 -->
            <Button Command="{Binding TestSourceConnectionCommand}"
                    IsEnabled="{Binding IsSourceConnecting, Converter={StaticResource InverseBoolConverter}}"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,0,0,12">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding IsSourceConnecting, Converter={StaticResource SourceConnectingTextConverter}}"
                           VerticalAlignment="Center"/>
              </StackPanel>
            </Button>

            <!-- Namespace 选择 -->
            <TextBlock Text="Namespace" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding SourceNamespaces}"
                      SelectedItem="{Binding SelectedSourceNamespace}"
                      DisplayMemberPath="DisplayText"
                      IsEnabled="{Binding IsSourceConnected}"/>
          </StackPanel>
        </Border>

        <!-- 目标端 Nacos -->
        <Border Grid.Column="2" Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                CornerRadius="4" Padding="16">
          <StackPanel>
            <TextBlock Text="目标端 Nacos" FontWeight="SemiBold" FontSize="14"
                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>

            <!-- 地址 -->
            <TextBlock Text="地址" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding TargetAddress, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12"/>

            <!-- 账号 -->
            <TextBlock Text="账号" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding TargetUsername, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12"/>

            <!-- 密码 -->
            <TextBlock Text="密码" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="TargetPasswordBox" PasswordChanged="OnTargetPasswordChanged"
                         Margin="0,0,0,12"/>

            <!-- 连接按钮 -->
            <Button Command="{Binding TestTargetConnectionCommand}"
                    IsEnabled="{Binding IsTargetConnecting, Converter={StaticResource InverseBoolConverter}}"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,0,0,12">
              <TextBlock Text="{Binding IsTargetConnecting, Converter={StaticResource TargetConnectingTextConverter}}"
                         VerticalAlignment="Center"/>
            </Button>

            <!-- Namespace 选择 + 新建按钮 -->
            <TextBlock Text="Namespace" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <ComboBox Grid.Column="0"
                        ItemsSource="{Binding TargetNamespaces}"
                        SelectedItem="{Binding SelectedTargetNamespace}"
                        DisplayMemberPath="DisplayText"
                        IsEnabled="{Binding IsTargetConnected}"/>

              <Button Grid.Column="2"
                      Content="新建"
                      Command="{Binding CreateTargetNamespaceCommand}"
                      IsEnabled="{Binding IsTargetConnected}"
                      Style="{StaticResource SecondaryButton}"
                      Padding="12,6"/>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- 中间数据区占位 -->
    <Border Grid.Row="2" Background="{DynamicResource SurfaceRaisedBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
            Margin="16,8" Padding="16">
      <TextBlock Text="中间数据工作区（阶段 4/5/6 实现）"
                 Foreground="{DynamicResource MutedBrush}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>

    <!-- GridSplitter -->
    <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch"
                  Background="{DynamicResource LineBrush}"
                  ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"/>

    <!-- 日志面板 -->
    <Border Grid.Row="4" Background="{DynamicResource SurfaceRaisedBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,1,1"
            Padding="16">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
          <TextBlock Text="日志" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextBrush}"
                     VerticalAlignment="Center"/>

          <Button Content="清空日志"
                  Command="{Binding ClearLogsCommand}"
                  Style="{StaticResource SecondaryButton}"
                  Padding="8,4"
                  HorizontalAlignment="Right"/>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Logs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding FormattedMessage}"
                           Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                           FontFamily="Consolas, Courier New"
                           FontSize="12"
                           Margin="0,2"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</Window>
