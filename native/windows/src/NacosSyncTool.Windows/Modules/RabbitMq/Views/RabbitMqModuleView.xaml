<UserControl x:Class="NacosSyncTool.Windows.Modules.RabbitMq.Views.RabbitMqModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:NacosSyncTool.Windows.Converters"
             Loaded="OnLoaded"
             Background="{DynamicResource BgBrush}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    <converters:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="#B42318"/>
      <Setter Property="BorderBrush" Value="#B42318"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
  </UserControl.Resources>

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="120"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource TopBar}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="← Nacos" Style="{StaticResource SecondaryButton}" Padding="12,5"
                  Click="OnBackToNacosClick" Margin="0,0,12,0"/>
          <Border Width="28" Height="28" CornerRadius="5" Background="#F97316" Margin="0,0,9,0">
            <TextBlock Text="RMQ" Foreground="White" FontSize="9" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel>
            <TextBlock Text="RabbitMQ 工具" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="拓扑同步与 Queue Ready 消息清理" FontSize="11"
                       Foreground="{DynamicResource FaintBrush}"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="拓扑同步" Style="{StaticResource SecondaryButton}" Padding="14,6"
                  Command="{Binding ShowTopologyCommand}"/>
          <Button Content="队列消息清理" Style="{StaticResource SecondaryButton}" Padding="14,6"
                  Margin="8,0,0,0" Command="{Binding ShowPurgeCommand}"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="0,12,0,10"
          Visibility="{Binding IsTopologyMode, Converter={StaticResource BoolToVisibility}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource FlowPanel}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*"/><ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="源 Management API" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding SourceAddress, UpdateSourceTrigger=PropertyChanged}"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="用户名" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding SourceUsername, UpdateSourceTrigger=PropertyChanged}"/>
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Text="密码" Style="{StaticResource FieldLabel}"/>
            <PasswordBox PasswordChanged="OnSourcePasswordChanged"/>
          </StackPanel>
          <Button Grid.Column="6" Content="连接源端" VerticalAlignment="Bottom"
                  Style="{StaticResource SecondaryButton}" Command="{Binding TestSourceConnectionCommand}"/>
        </Grid>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource FlowPanel}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*"/><ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="目标 Management API" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding TargetAddress, UpdateSourceTrigger=PropertyChanged}"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="用户名" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding TargetUsername, UpdateSourceTrigger=PropertyChanged}"/>
          </StackPanel>
          <StackPanel Grid.Column="4">
            <TextBlock Text="密码" Style="{StaticResource FieldLabel}"/>
            <PasswordBox PasswordChanged="OnTargetPasswordChanged"/>
          </StackPanel>
          <Button Grid.Column="6" Content="连接目标" VerticalAlignment="Bottom"
                  Style="{StaticResource SecondaryButton}" Command="{Binding TestTargetConnectionCommand}"/>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2" Visibility="{Binding IsTopologyMode, Converter={StaticResource BoolToVisibility}}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Style="{StaticResource WorkbenchShell}" Padding="12" Margin="0,0,0,8">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="源 Virtual Host" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Width="180" ItemsSource="{Binding SourceVirtualHosts}"
                      SelectedItem="{Binding SelectedSourceVirtualHost}" DisplayMemberPath="Name"/>
            <TextBlock Text="目标同名状态：" VerticalAlignment="Center" Margin="16,0,4,0"/>
            <TextBlock Text="{Binding TargetVirtualHostStatus}" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}"/>
            <CheckBox Content="选择性同步" IsChecked="{Binding IsSelectiveMode}"
                      Margin="16,0,0,0" VerticalAlignment="Center"/>
            <Button Content="加载资源" Margin="16,0,0,0" Style="{StaticResource SecondaryButton}"
                    Command="{Binding RefreshResourcesCommand}"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Content="生成预览" Style="{StaticResource SecondaryButton}" Command="{Binding BuildPlanCommand}"/>
            <Button Content="执行同步" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}"
                    Command="{Binding ExecutePlanCommand}"/>
            <Button Content="重试失败项" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                    Command="{Binding RetryFailedCommand}"/>
            <Button Content="取消" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                    Command="{Binding CancelCommand}"/>
          </StackPanel>
          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding PlanSummary}"
                     Margin="0,7,0,0" Foreground="{DynamicResource MutedBrush}"/>
        </Grid>
      </Border>
      <TabControl Grid.Row="1">
        <TabItem Header="Exchange">
          <DataGrid ItemsSource="{Binding Exchanges}">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="选择" Binding="{Binding IsSelected}" Width="55" IsReadOnly="False"/>
              <DataGridTextColumn Header="名称" Binding="{Binding Resource.Name}" Width="*" IsReadOnly="True"/>
              <DataGridTextColumn Header="类型" Binding="{Binding Resource.Type}" Width="100" IsReadOnly="True"/>
              <DataGridCheckBoxColumn Header="Durable" Binding="{Binding Resource.Durable}" Width="75" IsReadOnly="True"/>
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>
        <TabItem Header="Queue">
          <DataGrid ItemsSource="{Binding Queues}">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="选择" Binding="{Binding IsSelected}" Width="55" IsReadOnly="False"/>
              <DataGridTextColumn Header="名称" Binding="{Binding Resource.Name}" Width="*" IsReadOnly="True"/>
              <DataGridCheckBoxColumn Header="Durable" Binding="{Binding Resource.Durable}" Width="75" IsReadOnly="True"/>
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>
        <TabItem Header="Binding">
          <DataGrid ItemsSource="{Binding Bindings}">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="选择" Binding="{Binding IsSelected}" Width="55" IsReadOnly="False"/>
              <DataGridTextColumn Header="来源" Binding="{Binding Resource.Source}" Width="*" IsReadOnly="True"/>
              <DataGridTextColumn Header="目标" Binding="{Binding Resource.Destination}" Width="*" IsReadOnly="True"/>
              <DataGridTextColumn Header="Routing Key" Binding="{Binding Resource.RoutingKey}" Width="150" IsReadOnly="True"/>
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>
        <TabItem Header="Policy">
          <DataGrid ItemsSource="{Binding Policies}">
            <DataGrid.Columns>
              <DataGridCheckBoxColumn Header="选择" Binding="{Binding IsSelected}" Width="55" IsReadOnly="False"/>
              <DataGridTextColumn Header="名称" Binding="{Binding Resource.Name}" Width="*" IsReadOnly="True"/>
              <DataGridTextColumn Header="Pattern" Binding="{Binding Resource.Pattern}" Width="*" IsReadOnly="True"/>
              <DataGridTextColumn Header="Priority" Binding="{Binding Resource.Priority}" Width="80" IsReadOnly="True"/>
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>
      </TabControl>
    </Grid>

    <Grid Grid.Row="1" Grid.RowSpan="2" Margin="0,12,0,0"
          Visibility="{Binding IsPurgeMode, Converter={StaticResource BoolToVisibility}}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Style="{StaticResource FlowPanel}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0"><TextBlock Text="Management API" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding PurgeAddress}"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="用户名" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding PurgeUsername}"/></StackPanel>
          <StackPanel Grid.Column="4"><TextBlock Text="密码" Style="{StaticResource FieldLabel}"/><PasswordBox PasswordChanged="OnPurgePasswordChanged"/></StackPanel>
          <Button Grid.Column="6" Content="连接" VerticalAlignment="Bottom" Style="{StaticResource SecondaryButton}" Command="{Binding TestPurgeConnectionCommand}"/>
        </Grid>
      </Border>
      <Border Grid.Row="1" Style="{StaticResource WorkbenchShell}" Padding="12" Margin="0,10,0,8">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Virtual Host" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Width="180" ItemsSource="{Binding PurgeVirtualHosts}" SelectedItem="{Binding SelectedPurgeVirtualHost}" DisplayMemberPath="Name"/>
            <Button Content="刷新 Queue" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshPurgeQueuesCommand}"/>
            <TextBlock Text="{Binding ReadyTotal, StringFormat='Ready {0}'}" Margin="18,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding UnackedTotal, StringFormat='Unacked {0}'}" Margin="12,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Content="一键清空 Ready 消息" Style="{StaticResource DangerButton}"
                    Command="{Binding PurgeAllReadyMessagesCommand}" Padding="18,7"/>
            <Button Content="取消" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}"
                    Command="{Binding CancelCommand}"/>
          </StackPanel>
          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding PurgeSummary}"
                     Margin="0,7,0,0" Foreground="{DynamicResource MutedBrush}"/>
        </Grid>
      </Border>
      <DataGrid Grid.Row="2" ItemsSource="{Binding PurgeQueues}" IsReadOnly="True">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Queue" Binding="{Binding Name}" Width="*"/>
          <DataGridTextColumn Header="Ready" Binding="{Binding MessagesReady}" Width="100"/>
          <DataGridTextColumn Header="Unacked" Binding="{Binding MessagesUnacknowledged}" Width="100"/>
          <DataGridTextColumn Header="消费者" Binding="{Binding Consumers}" Width="100"/>
          <DataGridTextColumn Header="总消息" Binding="{Binding MessagesTotal}" Width="100"/>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>

    <Border Grid.Row="3" Style="{StaticResource LogWindow}" Margin="0,10,0,0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="12,7"><TextBlock Text="RabbitMQ 日志" Foreground="#e6ece5" FontWeight="SemiBold"/><Button Content="清空日志" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Command="{Binding ClearLogsCommand}"/></Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="12,0,12,8">
          <ItemsControl ItemsSource="{Binding Logs}">
            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding FormattedMessage}" Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}" FontFamily="Consolas" FontSize="11"/></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <Grid Grid.RowSpan="4" Background="#66000000" Panel.ZIndex="100" IsHitTestVisible="True"
          Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
      <Border Background="#EE202020" CornerRadius="8" Padding="18"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="{Binding BusyText}" Foreground="White" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding ProgressText}" Foreground="#DDFFFFFF" Margin="0,5,0,0"/>
          <Button Content="取消" Margin="0,12,0,0" Style="{StaticResource SecondaryButton}"
                  Command="{Binding CancelCommand}"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
