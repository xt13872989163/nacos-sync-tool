<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Forest Theme - 森林主题 (默认) -->

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="BgBrush" Color="#eef0ed"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#fbfcfa"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#f5f6f3"/>

    <!-- Lines -->
    <SolidColorBrush x:Key="LineBrush" Color="#d8ddd5"/>
    <SolidColorBrush x:Key="LineStrongBrush" Color="#c5ccc2"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush" Color="#202520"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#657066"/>
    <SolidColorBrush x:Key="FaintBrush" Color="#879085"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2f6f5e"/>
    <SolidColorBrush x:Key="AccentStrongBrush" Color="#245547"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#e2f0ea"/>

    <!-- Warn -->
    <SolidColorBrush x:Key="WarnBrush" Color="#8f5b12"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#fff0cf"/>

    <!-- Danger -->
    <SolidColorBrush x:Key="DangerBrush" Color="#a33a34"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#fae2de"/>

</ResourceDictionary>
