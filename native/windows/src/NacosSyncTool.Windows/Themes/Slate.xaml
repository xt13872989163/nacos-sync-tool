<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Slate Theme - 深灰主题 -->

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="BgBrush" Color="#e9edf1"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#f8fafc"/>
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#eef2f6"/>

    <!-- Lines -->
    <SolidColorBrush x:Key="LineBrush" Color="#d4dbe3"/>
    <SolidColorBrush x:Key="LineStrongBrush" Color="#b9c4cf"/>

    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush" Color="#17202a"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#5c6874"/>
    <SolidColorBrush x:Key="FaintBrush" Color="#7b8793"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#315f88"/>
    <SolidColorBrush x:Key="AccentStrongBrush" Color="#244865"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#dfeefa"/>

    <!-- Warn -->
    <SolidColorBrush x:Key="WarnBrush" Color="#8a5a15"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#fff0d2"/>

    <!-- Danger -->
    <SolidColorBrush x:Key="DangerBrush" Color="#a03832"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#fae2de"/>

</ResourceDictionary>
