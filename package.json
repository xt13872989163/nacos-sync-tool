{
  "name": "nacos-sync-tool",
  "version": "1.0.0",
  "description": "Desktop client for syncing Nacos configuration across clusters.",
  "productName": "Nacos Sync Tool",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "pack:win": "electron-builder --win nsis",
    "pack:mac": "electron-builder --mac dmg"
  },
  "dependencies": {},
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "axios": "^1.13.2",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "js-yaml": "^4.1.0",
    "npm-run-all": "^4.1.5",
    "pinia": "^3.0.4",
    "playwright": "^1.57.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.13",
    "vue": "^3.5.24",
    "vue-tsc": "^3.1.5"
  },
  "build": {
    "appId": "com.nacossynctool.app",
    "productName": "Nacos Sync Tool",
    "asar": true,
    "compression": "maximum",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
